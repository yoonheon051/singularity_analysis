<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>singularity_analysis</name>
  <version>0.1.0</version>
  <description>M0609 Jacobian 기반 특이점 분석: 실시간 모니터링, 가동성 타원체, 특이점 종류 분류, DLS 비교</description>
  <maintainer email="yoonheon051@users.noreply.github.com">yoonheon051</maintainer>
  <license>TODO: License declaration</license>

  <!-- 시뮬레이션 (launch/analysis.launch.py) -->
  <exec_depend>my_robot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- 분석 노드 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <!-- 실시간 대시보드: 브라우저가 WebSocket 으로 /singularity/status 를 받음 -->
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <!-- roboticstoolbox-python 은 rosdep 키가 없어 pip 로 설치: pip install -r requirements.txt -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
